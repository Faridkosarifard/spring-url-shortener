# Copy this file to .env and adjust the values. Do not commit .env.

SERVER_PORT=8080
# Use "dev" (default, in-memory H2) or "prod" (PostgreSQL).
SPRING_PROFILES_ACTIVE=dev

# Public base URL used when building short links.
SHORTURL_BASE_URL=http://localhost:8080

# Short codes
SHORTURL_CODE_LENGTH=7
SHORTURL_MAX_CODE_ATTEMPTS=8
# 302 keeps click counts accurate in browsers; set 301 for a permanent redirect.
SHORTURL_REDIRECT_STATUS=302

# Validation
SHORTURL_BLOCK_PRIVATE_HOSTS=true
# Comma-separated hostnames, for example: malware.test,bad.example
SHORTURL_BLOCKED_HOSTS=

# Rate limit applies to POST and DELETE under /api/.
SHORTURL_RATE_LIMIT_ENABLED=true
SHORTURL_RATE_LIMIT_RPM=60
# Enable only when a trusted proxy overwrites X-Forwarded-For.
SHORTURL_RATE_LIMIT_TRUST_FORWARDED_HEADERS=false

# Used when SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/shorturl
# SPRING_DATASOURCE_USERNAME=shorturl
# SPRING_DATASOURCE_PASSWORD=change-me
